{
  "name": "cs-aspnet (Rider)",
  "dockerComposeFile": [
    "../../docker-compose.yml",
    "../../docker-compose.cs-aspnet.yml"
  ],
  "service": "cs-aspnet",
  "workspaceFolder": "/usr/code",
  "postCreateCommand": "update-ca-certificates 2>/dev/null || true && dotnet restore",
  "customizations": {
    "jetbrains": {
      "backend": "Rider",
      "plugins": [
        "com.jetbrains.opentelemetry"
      ]
    }
  }
}
